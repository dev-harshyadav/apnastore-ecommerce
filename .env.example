# APNASTORE Environment Configuration Example
# Copy this file to .env and adjust values for local development

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Secret key for session signing and CSRF tokens (change this in production)
SECRET_KEY=apnastore-change-me-to-a-secure-random-key-in-production

# Database URI (defaults to SQLite in instance/apnastore.db)
DATABASE_URL=sqlite:///apnastore.db

# Flat shipping fee in INR (Default: 60)
SHIPPING_FLAT_RATE=60.00
# Minimum subtotal for free shipping in INR (Default: 999.00)
FREE_SHIPPING_THRESHOLD=999.00
